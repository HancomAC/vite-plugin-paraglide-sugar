{
  "name": "vite-plugin-paraglide-sugar",
  "version": "0.1.0",
  "description": "Compile ergonomic Paraglide message access into tree-shakable imports with Vite.",
  "keywords": [
    "i18n",
    "inlang",
    "paraglide",
    "svelte",
    "vite-plugin"
  ],
  "homepage": "https://github.com/HancomAC/vite-plugin-paraglide-sugar#readme",
  "bugs": "https://github.com/HancomAC/vite-plugin-paraglide-sugar/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HancomAC/vite-plugin-paraglide-sugar.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/vite.js",
  "types": "./dist/vite.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "lint": "oxlint src tests scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.58.0",
    "magic-string": "0.30.21",
    "svelte-eslint-parser": "1.9.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.20.1",
    "@inlang/sdk": "2.10.2",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "25.9.1",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "source-map-js": "1.2.1",
    "svelte": "5.53.6",
    "vite": "8.0.16",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@inlang/paraglide-js": "^2.18.1",
    "svelte": "^5.53.6",
    "vite": "^8.0.14"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.13.1"
}
